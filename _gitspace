#compdef gitspace wclone
# gitspace - completion for workspace names, SSH aliases and gh accounts.

_gitspace_workspaces() {
  local conf="${GITSPACE_CONF:-$HOME/.config/git/workspaces.conf}"
  [[ -f $conf ]] || return
  grep -v '^[[:space:]]*#' $conf 2>/dev/null | grep -v '^[[:space:]]*$' | cut -d'|' -f1
}

_gitspace_aliases() {
  awk '$1=="Host" { for(i=2;i<=NF;i++) if($i !~ /[*?]/) print $i }' \
    "$HOME/.ssh/config" 2>/dev/null
}

_gitspace_gh_accounts() {
  sed -n 's/^[[:space:]]*\([a-zA-Z0-9_-]*\):[[:space:]]*$/\1/p' \
    "$HOME/.config/gh/hosts.yml" 2>/dev/null | grep -v '^github$'
}

_gitspace() {
  local -a cmds
  cmds=(
    'install:hooks, config template and global settings'
    'add:register a workspace and bind an e-mail to it'
    'list:show registered workspaces'
    'doctor:verify the whole setup'
    'remove:unregister a workspace'
    'help:show usage'
  )

  if (( CURRENT == 2 )); then
    _describe -t commands 'gitspace' cmds
    return
  fi

  case ${words[2]} in
    add)
      _arguments \
        '1:workspace directory:_files -/' \
        '--email[address used for commits]:email:' \
        '--gh[gh account]:account:($(_gitspace_gh_accounts))' \
        '--alias[comma-separated SSH aliases]:alias:($(_gitspace_aliases))' \
        '--name[full name used for commits]:name:' \
        '--as[workspace name, when it differs from the directory name]:name:'
      ;;
    remove|rm)
      _values 'workspace' $(_gitspace_workspaces)
      ;;
  esac
}

_wclone() {
  if (( CURRENT == 2 )); then
    _message 'repository URL (git@host:group/repo.git, https://... or alias:group/repo)'
    compadd -S ':' $(_gitspace_aliases)
  else
    _files -/
  fi
}

case ${service:-$words[1]} in
  wclone) _wclone "$@" ;;
  *)      _gitspace "$@" ;;
esac
