#!/bin/sh
# gitspace: refuse a push over the wrong SSH key or from the wrong gh account.
# shellcheck source=lib/guard.sh
. "${GITSPACE_LIB:-$HOME/.config/git/hooks}/guard.sh"

URL=$(git remote get-url "$1" 2>/dev/null || echo "")

# Which of the workspace's aliases does this remote use?
MATCHED=""
OLDIFS=$IFS; IFS=','
for a in $EXP_SSH; do
  [ -n "$a" ] || continue
  case "$URL" in "$a":*) MATCHED="$a"; break ;; esac
done
IFS=$OLDIFS

if [ -z "$MATCHED" ]; then
  case "$URL" in
    https://github.com/*|git@github.com:*|https://gitlab*|git@gitlab*|ssh://git@*)
      die "wrong key" "Remote '$1' is $URL — it would use the default key.
  Workspace '$WS' allows: ${EXP_SSH:-<none>}" ;;
    *) ;;   # another host - not our business
  esac
fi

# The gh account applies to GitHub remotes ONLY; GitLab does not use it.
case "$MATCHED" in
  github-*)
    [ -n "$EXP_GH" ] || exit 0
    GH_HOSTS="$HOME/.config/gh/hosts.yml"
    if [ -f "$GH_HOSTS" ]; then
      ACT=$(sed -n 's/^[[:space:]]*user:[[:space:]]*\(.*\)$/\1/p' "$GH_HOSTS" | tail -1)
      [ -n "$ACT" ] || die "unknown gh account" "Cannot read the active account from $GH_HOSTS."
      [ "$ACT" = "$EXP_GH" ] || die "wrong gh account" \
        "The active gh account is '$ACT', but workspace '$WS' requires '$EXP_GH'.
  Fix:  gh auth switch --user $EXP_GH"
    fi
  ;;
esac

OWN="$(git rev-parse --git-dir)/hooks/pre-push"
[ -x "$OWN" ] && exec "$OWN" "$@"
exit 0
